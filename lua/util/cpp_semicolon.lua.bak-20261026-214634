-- 在 struct / class / union / enum 定义的右花括号后自动补 ";"
-- 函数体、if/for/namespace/typedef 等块不会被加
local M = {}

local TYPE_KEYWORDS = { struct = true, class = true, union = true, enum = true }

-- 注意：Lua 模式没有 "|" 交替语法，只能逐个比较关键字
local function starts_type_decl(line)
  local kw = line:match("^%s*(%a[%w_]*)")
  if kw and TYPE_KEYWORDS[kw] then
    return true
  end
  local tkw = line:match("^%s*template%s*<.-%>%s*(%a[%w_]*)")
  if tkw and TYPE_KEYWORDS[tkw] then
    return true
  end
  return false
end

-- 从 row 行、col 之前向左找与右花括号配对的左花括号；返回该行行号与文本
local function find_matching_open(buf, row, col)
  for r = row, 1, -1 do
    local line = vim.api.nvim_buf_get_lines(buf, r - 1, r, false)[1] or ""
    local i = (r == row) and col or #line
    local depth = 0
    while i >= 1 do
      local c = line:sub(i, i)
      if c == "}" then
        depth = depth + 1
      elseif c == "{" then
        depth = depth - 1
        if depth < 0 then
          return r, line
        end
      end
      i = i - 1
    end
  end
  return nil
end

function M.fix(buf)
  buf = (buf == nil or buf == 0) and vim.api.nvim_get_current_buf() or buf
  local ft = vim.bo[buf].filetype
  if ft ~= "c" and ft ~= "cpp" then
    return false
  end
  local win = vim.api.nvim_get_current_win()
  if vim.api.nvim_win_get_buf(win) ~= buf then
    return false
  end
  local row, col = unpack(vim.api.nvim_win_get_cursor(win))
  local line = vim.api.nvim_buf_get_lines(buf, row - 1, row, false)[1] or ""
  if line:sub(col + 1, col + 1) ~= "}" then
    return false
  end
  if line:sub(col + 2):match("%S") then
    return false
  end
  local orow, oline = find_matching_open(buf, row, col)
  if not orow or not starts_type_decl(oline) then
    return false
  end
  vim.api.nvim_buf_set_text(buf, row - 1, col + 1, row - 1, col + 1, { ";" })
  vim.api.nvim_win_set_cursor(win, { row, col + 1 })
  return true
end

return M
