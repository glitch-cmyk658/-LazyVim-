-- Markdown 图片显示方式：内联常显 <-> 悬停浮窗（依赖 Pebrel 的 kitty 占位符支持）
vim.keymap.set("n", "<leader>ui", function()
  local doc = Snacks.image.config.doc
  doc.inline = not doc.inline
  local buf = vim.api.nvim_get_current_buf()
  pcall(function() Snacks.image.doc.hover_close() end)
  pcall(vim.api.nvim_clear_autocmds, { group = "snacks.image.doc." .. buf })
  for name, ns in pairs(vim.api.nvim_get_namespaces()) do
    if name:find("snacks.image.inline", 1, true) then
      pcall(vim.api.nvim_buf_clear_namespace, buf, ns, 0, -1)
    end
  end
  vim.b[buf].snacks_image_attached = nil
  Snacks.image.doc.attach(buf)
  Snacks.notify.info(("Markdown 图片：%s"):format(doc.inline and "内联常显" or "悬停浮窗"))
end, { desc = "Toggle Markdown image inline/floating" })

-- ===== 注释 / 取消注释（整行）=====
-- x 模式：把选中的所有行注释掉；n 模式：注释光标所在行。
-- 注释符取自当前 filetype 的 commentstring（// # -- /* */ …），
-- 整个块已经注释过时再按一次是取消，保留原有缩进与换行。
local comment = require("util.comment")
local function comment_visual()
  comment.toggle_visual()
end
local function comment_line()
  comment.toggle_line()
end

vim.keymap.set("x", "<leader>c/", comment_visual, { desc = "注释/取消注释选中行" })
vim.keymap.set("n", "<leader>c/", comment_line, { desc = "注释/取消注释当前行" })

-- 终端能送出 Ctrl+/ 时（多数终端发 0x1f，nvim 认作 <C-_>）也绑上同一个功能。
for _, lhs in ipairs({ "<C-/>", "<C-_>" }) do
  pcall(vim.keymap.set, "x", lhs, comment_visual, { desc = "注释/取消注释选中行" })
  pcall(vim.keymap.set, "n", lhs, comment_line, { desc = "注释/取消注释当前行" })
end

-- ===== Markdown：交给 Windows 上的 Obsidian 预览 =====
-- 为什么：nvim 里渲染公式要给每个 $...$ 起子进程（latex2text 每次 ~58ms），
-- 公式上百个的文件滚动/移动光标都卡；Obsidian 是独立进程，公式/图片/表格它自己渲染，
-- nvim 这边保持纯文本，零卡顿，磁盘上是同一份文件。
-- 注意：Obsidian 只能打开「库（vault）」里的文件。文件不在库内时，这里退化成打开它
-- 所在的文件夹，Obsidian 会弹「是否作为库打开」，点一次以后就正常了。
-- （Typora 试过但没有成功：本机 Typora.exe 启动后立即以退出码 0 结束、不生成进程。）

local _win_path = function(p)
  local out = vim.fn.systemlist({ "wslpath", "-w", p })[1]
  if not out or out == "" then
    return nil
  end
  return out
end

-- 百分号编码：只保留 RFC 3986 的 unreserved
local function url_encode(s)
  return (s:gsub("[^%w%-%._~]", function(c)
    return string.format("%%%02X", string.byte(c))
  end))
end

-- 读 Obsidian 的库列表（%APPDATA%\obsidian\obsidian.json），结果缓存在模块级变量里。
local _vaults
local function obsidian_vaults()
  if _vaults then
    return _vaults
  end
  _vaults = {}
  local appdata = vim.fn.systemlist({ "cmd.exe", "/c", "echo", "%APPDATA%" })[1]
  if not appdata or appdata == "" then
    return _vaults
  end
  local wsl_path = vim.fn.systemlist({ "wslpath", "-u", (appdata:gsub("%s+$", "")) })[1]
  if not wsl_path or wsl_path == "" then
    return _vaults
  end
  local f = io.open(wsl_path .. "/obsidian/obsidian.json", "r")
  if not f then
    return _vaults
  end
  local raw = f:read("*a")
  f:close()
  for path in raw:gmatch('"path"%s*:%s*"([^"]+)"') do
    local dec = path:gsub("\\\\", "\\") -- JSON 里是双反斜杠
    table.insert(_vaults, dec)
  end
  return _vaults
end

local function in_vault(win_file)
  local lower = win_file:lower()
  for _, v in ipairs(obsidian_vaults()) do
    local vl = (v:lower():gsub("\\+$", ""))
    if lower:sub(1, #vl + 1) == vl .. "\\" then
      return true, v
    end
  end
  return false, nil
end

local function obsidian_open(uri)
  -- 必须走 start "" "<uri>"：直接启动 Obsidian.exe 时 WSL 传来的参数会被 Electron 当成 node 脚本
  vim.fn.system({ "cmd.exe", "/c", "start", "", uri })
  return vim.v.shell_error == 0
end

local function open_in_obsidian()
  local file = vim.api.nvim_buf_get_name(0)
  if file == "" then
    return vim.notify("当前 buffer 还没存盘，先 :w 再预览", vim.log.levels.WARN)
  end
  if vim.bo.filetype ~= "markdown" and vim.bo.filetype ~= "markdown.mdx" then
    return vim.notify("Obsidian 只预览 Markdown", vim.log.levels.WARN)
  end
  if vim.bo.modified then
    vim.notify("有未保存修改：Obsidian 看到的是磁盘上的旧内容，先 :w", vim.log.levels.WARN)
  end
  local win = _win_path(file)
  if not win then
    return vim.notify("wslpath 转 Windows 路径失败", vim.log.levels.ERROR)
  end
  local ok, vault = in_vault(win)
  if ok then
    if obsidian_open("obsidian://open?path=" .. url_encode(win)) then
      vim.notify("Obsidian: " .. vim.fn.fnamemodify(file, ":t") .. "  [" .. vault .. "]")
    else
      vim.notify("调用 Obsidian 失败（obsidian:// 协议没注册？）", vim.log.levels.ERROR)
    end
    return
  end
  -- 不在任何库里：Obsidian 的 open?path 打不开库外路径（会弹 Error），所以只提示。
  local dir = win:match("^(.*)\\[^\\]+$")
  vim.notify(
    "这个文件不在 Obsidian 的库里，打不开。\n"
      .. "在 Obsidian 里：左下角「打开其他仓库 → 打开文件夹作为仓库」，选下面的目录（只需一次）：\n"
      .. tostring(dir),
    vim.log.levels.WARN
  )
end

vim.keymap.set("n", "<leader>mo", open_in_obsidian, { desc = "用 Obsidian 预览当前 Markdown" })
vim.api.nvim_create_user_command("Obsidian", open_in_obsidian, { desc = "用 Obsidian 预览当前 Markdown" })
