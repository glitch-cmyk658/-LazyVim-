-- ===== 行首 / 行尾 =====
-- Alt-h / Alt-l：和 h/l 同方向，单键触发，不占用常用键
vim.keymap.set({ "n", "x", "o" }, "<M-h>", "^", { desc = "行首（第一个非空白字符）" })
-- Alt-l：行尾。普通模式停在最后一个字符之后（配合 virtualedit=onemore），
-- 可视/操作符模式仍用 $（选区与操作范围保持原语义）
vim.keymap.set("n", "<M-l>", function()
  vim.cmd("normal! $")
  pcall(vim.cmd, "normal! l")
end, { desc = "行尾（最后一个字符之后）" })
vim.keymap.set({ "x", "o" }, "<M-l>", "$", { desc = "行尾" })
-- 0 仍指向第一个非空白字符；真正的第 0 列用 <Home> 或 g0
vim.keymap.set({ "n", "x", "o" }, "0", "^", { desc = "行首（第一个非空白字符）" })

