-- translate (port from vim-translator)
vim.keymap.set("v", "<leader>tt", function()
  require("translate").translate(require("translate").visual_text(), "zh-CN")
end, { desc = "Translate selection -> 中文" })
vim.keymap.set("n", "<leader>tt", function()
  require("translate").translate(vim.fn.expand("<cword>"), "zh-CN")
end, { desc = "Translate word -> 中文" })
vim.keymap.set("v", "<leader>tr", function()
  require("translate").replace("zh-CN")
end, { desc = "Replace selection with 中文" })
vim.keymap.set("v", "<leader>te", function()
  require("translate").translate(require("translate").visual_text(), "en")
end, { desc = "Translate selection -> English" })

-- LSP: 跳转到定义（LazyVim 默认只给了 gr* 一组，补一个单键）
vim.keymap.set("n", "<leader>gd", vim.lsp.buf.definition, { desc = "Goto Definition" })

vim.keymap.set("i", "jk", "<ESC>")
